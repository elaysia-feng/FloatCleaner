#include <windows.h>

// 应用图标（exe 文件 / 任务栏 / 窗口类共用），由 tools/make_icon.cpp 生成
1 ICON "app.ico"

#define FC_VERSION_MAJOR 1
#define FC_VERSION_MINOR 0
#define FC_VERSION_PATCH 1

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    FC_VERSION_MAJOR,FC_VERSION_MINOR,FC_VERSION_PATCH,0
 PRODUCTVERSION FC_VERSION_MAJOR,FC_VERSION_MINOR,FC_VERSION_PATCH,0
 FILEFLAGSMASK  0x3fL
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080404b0"
        BEGIN
            VALUE "CompanyName",      "FloatCleaner contributors"
            VALUE "FileDescription",  "FloatCleaner - 进程清理悬浮窗"
            VALUE "FileVersion",      "1.0.1.0"
            VALUE "InternalName",     "FloatCleaner"
            VALUE "LegalCopyright",   "MIT License"
            VALUE "OriginalFilename", "FloatCleaner.exe"
            VALUE "ProductName",      "FloatCleaner"
            VALUE "ProductVersion",   "1.0.1.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0804, 1200
    END
END
